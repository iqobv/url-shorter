model User {
  id String @id @default(uuid())

  email    String  @unique
  password String?

  emailVerified Boolean @default(false) @map("email_verified")

  username    String  @unique
  displayName String? @map("display_name")

  role UserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens        Token[]
  links         Link[]
  userProviders UserProvider[]
  inviteLinks   InviteLink[]
  workspaces    Workspace[]

  workspaceMemberships          WorkspaceMember[] @relation("workspaceMembers")
  invitedByWorkspaceMemberships WorkspaceMember[] @relation("invitedByWorkspaceMembers")

  auditLogs       AuditLog[] @relation("user")
  targetAuditLogs AuditLog[] @relation("targetUser")

  @@map("users")
}
